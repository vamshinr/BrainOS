# BrainOS — single config for the Mnemosyne backend AND the Next.js frontend.
# Copy to .env and fill in secrets. Read by Mnemosyne (config.py) and Next.js.

# ── Neo4j (causal graph store) ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_EVENT_LABEL=MnemosyneEvent

# ── Qdrant (vector store) ──
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=mnemosyne_events

# ── Embeddings + LLM (Haiku only) ──
EMBEDDING_MODEL=all-MiniLM-L6-v2
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-haiku-4-5-20251001
JUDGMENT_MODEL=claude-haiku-4-5-20251001

# ── Ingestion / large-file chunking (optional; defaults shown) ──
# CHUNK_ENABLED=true            # chunk large inputs across LLM calls (false = always one call)
# CHUNK_MAX_CHARS=12000         # inputs <= this length are extracted in a single call
# CHUNK_SIZE_CHARS=8000         # target size of each chunk when chunking kicks in
# CHUNK_CONTEXT_CHARS=800       # trailing chars carried into the next chunk (sliding window)
# CHUNK_MAX_CONCURRENCY=4       # chunks extracted in parallel
# EXTRACTION_MAX_TOKENS=4096    # max output tokens per extraction call

# ── Async ingestion job queue (optional; defaults shown) ──
# JOB_WORKERS=2          # ingestions processed in parallel
# JOB_RECENT_LIMIT=20    # finished jobs kept in the dock's "recent" history

# ── Causal scorer (optional; defaults shown) ──
# CANDIDATE_TOP_K=5             # candidate causes judged per ingested event (one batched LLM call)
# CONFIDENCE_THRESHOLD=0.55     # edges below this are stored but excluded from default traversal
# WEIGHT_TEMPORAL=0.3           # blend weight: temporal precedence + proximity
# WEIGHT_ASSOCIATION=0.2        # blend weight: embedding cosine between cause and effect
# WEIGHT_LLM=0.5                # blend weight: batched LLM causal judgment
# TEMPORAL_TAU_S=1800           # temporal decay half-life (seconds)
# TEMPORAL_MAX_WINDOW_S=21600   # lookback window for candidate causes (seconds)

# ── Frontend → Mnemosyne backend ──
BACKEND_URL=http://localhost:8090
