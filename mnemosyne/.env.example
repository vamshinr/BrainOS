# Mnemosyne configuration. Copy to mnemosyne/.env and fill in.
# Secrets are read from env only — never hardcoded.

# --- Neo4j (graph store; the only graph backend, per build constraint) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Namespaced label so we never collide with foreign :Event nodes in a shared instance.
NEO4J_EVENT_LABEL=MnemosyneEvent

# --- Qdrant (vector store for the semantic anchor step) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=mnemosyne_events

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- LLM (Anthropic). ANTHROPIC_API_KEY preferred; CLAUDE_API_KEY also accepted. ---
# ANTHROPIC_API_KEY=sk-ant-...
EXTRACTION_MODEL=claude-haiku-4-5-20251001
# Causal judgment uses Haiku only (project directive).
JUDGMENT_MODEL=claude-haiku-4-5-20251001

# --- Causal engine tuning (sane defaults; override only to experiment) ---
CONFIDENCE_THRESHOLD=0.55
TEMPORAL_TAU_S=1800
TEMPORAL_MAX_WINDOW_S=21600
WEIGHT_TEMPORAL=0.3
WEIGHT_LINGUISTIC=0.2
WEIGHT_LLM=0.5
DEDUP_SIMILARITY=0.92
DEDUP_TIME_WINDOW_S=3600
SALIENCE_HALF_LIFE_S=604800
FORWARD_TRAVERSAL=true
ANCHOR_TOP_K=5
MAX_HOPS=12
