{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Mnemosyne API (debug)",
      "preLaunchTask": "start-stores",
      "type": "debugpy",
      "request": "launch",
      "module": "mnemosyne",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/mnemosyne/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": { "PORT": "8090" },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Mnemosyne API (uvicorn, no reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["mnemosyne.api.app:app", "--host", "0.0.0.0", "--port", "8090"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/mnemosyne/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Mnemosyne tests (all)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["mnemosyne/tests", "-v"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/mnemosyne/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Mnemosyne tests (current file)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v", "-s"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/mnemosyne/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
